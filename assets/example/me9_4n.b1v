;    JOBNAME:FS_LESEN_DETAIL
;    JOBCOMMENT:Fehlerspeicher auslesen
;    ARG:FEHLERNR
;    ARGTYPE:int
;    ARGCOMMENT:wird die Nummer des zu lesenden Fehlers im Fehlerspeicher uebergeben
;    RESULT:JOB_STATUS
;    RESULTTYPE:string
;    RESULTCOMMENT:"OKAY", wenn fehlerfrei
;    RESULT:F_ANZ_INT
;    RESULTTYPE:int
;    RESULTCOMMENT:Anzahl der eingetragenen Fehler
;    RESULT:F_ORT_NR
;    RESULTTYPE:int
;    RESULTCOMMENT:Fehlercode des SG als Index
;    RESULT:F_ORT_TEXT
;    RESULTTYPE:string
;    RESULTCOMMENT:Fehlercode des SG als Text
;    RESULT:F_SYMPTOM_NR
;    RESULTTYPE:int
;    RESULTCOMMENT:Gibt die Nummer der Fehlerart aus
;    RESULT:F_SYMPTOM_TEXT
;    RESULTTYPE:string
;    RESULTCOMMENT:Interpretiert die Fehlerart
;    RESULT:F_READY_NR
;    RESULTTYPE:int
;    RESULTCOMMENT:Gibt an, ob Readiness gesetzt
;    RESULT:F_READY_TEXT
;    RESULTTYPE:string
;    RESULTCOMMENT:gibt einen Text zur Readiness aus
;    RESULT:F_VORHANDEN_NR
;    RESULTTYPE:int
;    RESULTCOMMENT:Gibt die Nummer des Eintragstatuses aus
;    RESULT:F_VORHANDEN_TEXT
;    RESULTTYPE:string
;    RESULTCOMMENT:gibt die Eintragsentprellung des Fehlers an
;    RESULT:F_WARNUNG_NR
;    RESULTTYPE:int
;    RESULTCOMMENT:Gibt die Nummer fuer MIL EIN aus
;    RESULT:F_WARNUNG_TEXT
;    RESULTTYPE:string
;    RESULTCOMMENT:gibt an, ob die MIL angesteuert wird
;    RESULT:F_ZYKLUS_FLAG
;    RESULTTYPE:string
;    RESULTCOMMENT:gibt an, ob Zyklus-Flag gesetzt wurden ist
;    RESULT:F_LZ
;    RESULTTYPE:int
;    RESULTCOMMENT:Wert Loeschvorgaenge DLC
;    RESULT:F_UW_ANZ
;    RESULTTYPE:int
;    RESULTCOMMENT:Anzahl der Umweltbedingungen des einzelnen Fehlers
;    RESULT:F_UW_KM
;    RESULTTYPE:string
;    RESULTCOMMENT:Km-Stand bei Erstauftreten
;    RESULT:F_UW1_NR
;    RESULTTYPE:int
;    RESULTCOMMENT:1.Satz Umweltbedingung 1 Index (Ersterkennung)
;    RESULT:F_UW1_TEXT
;    RESULTTYPE:string
;    RESULTCOMMENT:1.Satz UW1 Text zur Umweltbedingung
;    RESULT:F_UW1_WERT
;    RESULTTYPE:real
;    RESULTCOMMENT:1.Satz UW1 Wert der Umweltbedingung
;    RESULT:F_UW1_EINH
;    RESULTTYPE:string
;    RESULTCOMMENT:1.Satz UW1 Einheit
;    RESULT:F_UW2_NR
;    RESULTTYPE:int
;    RESULTCOMMENT:1.Satz Umweltbedingung 2 Index (Ersterkennung)
;    RESULT:F_UW2_TEXT
;    RESULTTYPE:string
;    RESULTCOMMENT:1.Satz UW2 Text zur Umweltbedingung
;    RESULT:F_UW2_WERT
;    RESULTTYPE:real
;    RESULTCOMMENT:1.Satz UW2 Wert der Umweltbedingung
;    RESULT:F_UW2_EINH
;    RESULTTYPE:string
;    RESULTCOMMENT:1.Satz UW2 Einheit
;    RESULT:F_UW3_NR
;    RESULTTYPE:int
;    RESULTCOMMENT:1.Satz Umweltbedingung 3 Index (Ersterkennung)

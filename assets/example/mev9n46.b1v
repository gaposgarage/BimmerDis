;    RESULTTYPE:binary
;    RESULTCOMMENT:Hex-Auftrag an SG
;    RESULT:_TEL_ANTWORT
;    RESULTTYPE:binary
;    RESULTCOMMENT:Hex-Antwort von SG
;

TBEG "VVTSTATUSBG2_2"
HEAD "STATI", "TEXT"
LINE "0x00", "keine Testeranforderung vorhanden"
LINE "0x01", "Startbedingung nicht erfüllt (Motorlauf)"
LINE "0x02", "nicht belegt"
LINE "0x03", "nicht belegt"
LINE "0x04", "nicht belegt"
LINE "0x05", "Lernvorgang aktiv"
LINE "0x06", "nicht belegt"
LINE "0x07", "Abbruch durch Motorlauf, Fehler im VVT-System, Rücknahme Lernanforderung"
LINE "0x08", "Lernanforderung ohne Fehler beendet"
LINE "0x09", "Lernvorgang mit aufgetretenem Fehler beendet"
LINE "0xXY", "Fehlerhafter Status"
TEND

TBEG "EWSSTART"
HEAD "STATI", "TEXT"
LINE "0x00", "ME9.2 bereit, Startwert zu empfangen"
LINE "0x01", "kein freier Startwert mit Freigabe vorhanden"
LINE "0x02", "noch kein Startwert gespeichert"
LINE "0x03", "Startwert nicht plausibel (wie im DS2-LH definiert)"
LINE "0xXY", "Fehlerhafter Status"
TEND

TBEG "EWSEMPFANGSSTATUS"
HEAD "STATI", "TEXT"
LINE "0x00", "Startwertprogrammierung bzw. -ruecksetzen war erfolgreich"
LINE "0x01", "falscher Startwert beim Ruecksetzen (EWS u. DME passen ni. zusammen) "
LINE "0x02", "Telegramminhalt war kein Startwert (event. Wechselcode)"
LINE "0x03", "Schnittstellenfehler DWA: Frame o. Parity oder kein Signal (Timeout)"
LINE "0x04", "Prozess laeuft"
LINE "0x05", "Programmierung bzw. Ruecksetzen im Fahrzyklus noch nicht ausgefuehrt"
LINE "0x06", "gleiche Zufallszahl wie bei vorherigem Ruecksetzen trotz Weiterschaltung"
LINE "0x07", "noch kein Startwert programmiert"
LINE "0x10", "Startwert nicht korrekt in Flash programmiert"
LINE "0x11", "Wechselcode nicht korrekt in EEPROM-Spiegel programmiert"
LINE "0x12", "Zufallszahl nicht korrekt in EEPROM-Spiegel programmiert"
LINE "0x20", "Fehler bei Startwertprogrammierroutine"
LINE "0x21", "2-aus-3-Startwertablage im Flash nicht in Ordnung"
LINE "0x22", "Ablage im EEPROM-Spiegel nicht in Ordnung"
LINE "0xXY", "Fehlerhafter Status"
TEND

TBEG "REGEL"
HEAD "WERT", "UWTEXT"
LINE "0x00", "--                                                                   "
LINE "0x01", "Regelung AUS, Einschaltbedingung noch nicht erfuellt"
LINE "0x02", "Regelung EIN"
LINE "0x04", "Regelung AUS wegen Fahrbedingung"
LINE "0x08", "Regelung AUS wegen erkanntem Fehler"
LINE "0x10", "Regelung EIN mit Einschraenkung"
LINE "0xXY", "??                         "
TEND

TBEG "SLSSTATUS"
HEAD "STATI", "TEXT"
LINE "0x00", "Sekundaerluftdiagnose laeuft aufgrund einer Testanforderung gerade ab"
LINE "0x01", "Systemtest kann nicht gestartet werden"
LINE "0x02", "Funktionsanforderung vorhanden"
LINE "0x05", "keine Funktionsanforderung an die Sekundaerluftdiagnose"
LINE "0x06", "Systemtest SLS ist beendet"
LINE "0x10", "Sekundaerluftmindermasse erkannt (bei 2 Bank Systemen gilt dies nur für Bank1)"
LINE "0x11", "Sekundaerluftmindermasse auf Bank2 erkannt (nur bei 2 Bank Systemen, keine Bewertung von Bank1)"
LINE "0x12", "Sekundaerluftmindermasse auf Bank1 und Bank2 erkannt (nur bei 2 Bank Systemen)"
LINE "0x13", "Sekundaerluftdiagnoseergebnis n.i.o. (bei 2 Bank Systemen gilt Aussage nur für Bank1)"
LINE "0x14", "Sekundaerluftdiagnoseergebnis 2 n.i.o. (nur bei 2 Bank Systemen)"
LINE "0x15", "Sekundaerluftdiagnoseergebnis Bank 1 + 2 n.i.o. (nur bei 2 Bank Systemen)"
LINE "0x16", "Sekundaerluftdiagnoseergebnis i.o."
LINE "0x20", "Sekundaerluftwicklungstemperatur zu groß"
LINE "0x21", "SLP-Abbruch z.B. aufgrund: Sek Druckdifferenz, Batteriesp., Motorluftmasse außerhalb der Schwellen"
LINE "0x22", "Messphase abgebrochen wurde"
LINE "0x23", "Offsetphase abgebrochen wurde"
LINE "0x24", "Vorsteuerung auf Bank1 und Bank2 außerhalb der Schwellen lag (nur bei 2-Bank Systemen)"
LINE "0x25", "Vorsteuerung auf Bank1 außerhalb der Schwellen lag"
LINE "0x26", "Vorsteuerung auf Bank2 außerhalb der Schwellen lag"
LINE "0x30", "Motortemperatur noch zu gering ist"
LINE "0x31", "Wicklungstemperatur noch zu hoch ist"
LINE "0x32", "Fehler einer das Ergebnis beeinflussenden Komponente vorliegt"
LINE "0x33", "Motortemp., Ansauglufttemp. oder Kattemp. außerhalb der Grenzen, B_zslsp(2) noch nicht geloescht"
LINE "0x34", "Motorluftmasse außerhalb der Grenzen liegt"
LINE "0x35", "LSU(2) nicht Betriebsbereit, VVT umschaltet, r1 nicht im Diagnosefenster"
LINE "0x36", "Tankentlueftung aktiv ist"
LINE "0xFE", "nicht genau spezifizierter Grund"
LINE "0xFF", "Ungueltigkeitswert (wird zur Zeit nicht benutzt)"
LINE "0xXY", "Status Systemtest SLS kann nicht ausgegeben werden"
TEND


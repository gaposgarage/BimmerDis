TBEG "JOBRESULT"
HEAD "SB", "STATUS_TEXT"
LINE "0xA0", "OKAY"
LINE "0xA2", "ERROR_ECU_REJECTED"
LINE "0xB1", "ERROR_ECU_FUNCTION"
LINE "0xFF", "ERROR_ECU_NACK"
LINE "0xXY", "ERROR_ECU_UNKNOWN_STATUSBYTE"
TEND

TBEG "FORTTEXTE"
HEAD "ORT", "ORTTEXT"
LINE "0x01", "Datenunterbrechung Signalleitung zum MFL"
LINE "0x02", "Tasten rechts SB und VER gleichzeitig betaetigt"
LINE "0x03", "Tasten links Radio-laut und leise gleichzeitig betaetigt"
LINE "0x07", "Kurzschluss Versorgungsspannung Lenkrad gegen Masse"
LINE "0x0A", "EEPROM Schreibfehler"
LINE "0xXY", "unbekannte Fehlerart"
TEND

TBEG "FARTTEXTE"
HEAD "ARTNR", "ARTTEXT"
LINE "0x00", "Fehler nicht aktiv"
LINE "0x20", "Fehler aktiv"
LINE "0xXY", "unbekannte Fehlerart"
TEND

TBEG "SG_BETRIEBSMODE"
HEAD "B_ART", "B_ART_TEXTE"
LINE "0x01", "Radio"
LINE "0x02", "Telefon"
LINE "0x04", "Umluft"
LINE "0x08", "Tempomat"
TEND

TBEG "EINGANG_RECHTS"
HEAD "TASTE_R", "TASTE_R_TEXTE"
LINE "0x09", "Tempomat Wiederaufnahme"
LINE "0x12", "Tempomat Setzen Beschleunigen"
LINE "0x40", "Tempomat Verzoegerung"
LINE "0x24", "Tempomat Aus"
LINE "0x80", "Umluft"
TEND

TBEG "EINGANG_LINKS"
HEAD "TASTE_L", "TASTE_L_TEXTE"
LINE "0x83", "Suchlauf aufwaerts"
LINE "0x43", "Lautstaerke plus"
LINE "0x23", "Lautstaerke minus"
LINE "0x13", "Suchlauf abwaerts"
LINE "0x0B", "Radio/Telefon"
LINE "0x07", "Telefon"
TEND

TBEG "LIEFERANTEN"
HEAD "LIEF_NR", "LIEF_NAME"
LINE "0x01", "Reinshagen"
LINE "0x02", "Kostal"
LINE "0x03", "Hella"
LINE "0x04", "Siemens"
LINE "0x05", "Eaton"
LINE "0x06", "UTA"
LINE "0x07", "Helbako"

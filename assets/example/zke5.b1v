IS_LESEN_ZV#
;    JOBNAME:IS_LESEN_ZV
;    JOBCOMMENT:Infospeicher lesen / Sonderfall: ZV-Ringspeicher
;    JOBCOMMENT:Analog zu FS_LESEN gibt es mehrere (15+1) Ergebnis-Saetze
;    JOBCOMMENT:Im Satz  1 steht die Information zum letzten ZV-Befehl.
;    JOBCOMMENT:Im Satz 15 steht die aelteste Information.
;    JOBCOMMENT:Im Satz 16 steht das Ergebnis JOB_STATUS.
;    RESULT:JOB_STATUS
;    RESULTTYPE:string
;    RESULTCOMMENT:OKAY, wenn fehlerfrei
;    RESULTCOMMENT:table JobResult STATUS_TEXT
;    RESULT:I_ZEIGER_RS
;    RESULTTYPE:int
;    RESULTCOMMENT:Zeigerwert des ZV-Ringspeichers
;    RESULTCOMMENT:Bereich: 0-28
;    RESULT:I_HEX_CODE_RS
;    RESULTTYPE:binary
;    RESULTCOMMENT:Ringspeicherdaten (alle 15 ZV-Befehle) als Hexcode
;    RESULT:I_HEX_CODE
;    RESULTTYPE:binary
;    RESULTCOMMENT:Ringspeicherdaten (einzelner ZV-Befehl) als Hexcode
;    RESULT:I_ZV_BEFEHL_WERT
;    RESULTTYPE:int
;    RESULTCOMMENT:zuletzt ausgefuehrter ZV-Befehl
;    RESULTCOMMENT:moegliche Werte: 0=SER, 1=VR, 2=ER, 3=ZS, 4=ES
;    RESULT:I_ZV_BEFEHL
;    RESULTTYPE:string
;    RESULTCOMMENT:zuletzt ausgefuehrter ZV-Befehl
;    RESULTCOMMENT:Bereich: SER, VR, ER, ZS, ES
;    RESULT:I_SCHLOSS_FT
;    RESULTTYPE:int
;    RESULTCOMMENT:Fahrerschloss
;    RESULTCOMMENT:Bereich: 0, wenn FALSE / 1, wenn TRUE
;    RESULT:I_SCHLOSS_BT
;    RESULTTYPE:int
;    RESULTCOMMENT:Beifahrerschloss
;    RESULTCOMMENT:Bereich: 0, wenn FALSE / 1, wenn TRUE
;    RESULT:I_FB
;    RESULTTYPE:int
;    RESULTCOMMENT:Fernbedienung
;    RESULTCOMMENT:Bereich: 0, wenn FALSE / 1, wenn TRUE
;    RESULT:I_CL
;    RESULTTYPE:int
;    RESULTCOMMENT:Centerlock
;    RESULTCOMMENT:Bereich: 0, wenn FALSE / 1, wenn TRUE
;    RESULT:I_CS
;    RESULTTYPE:int
;    RESULTCOMMENT:Crash-Sensor
;    RESULTCOMMENT:Bereich: 0, wenn FALSE / 1, wenn TRUE
;    RESULT:I_4KMH
;    RESULTTYPE:int
;    RESULTCOMMENT:groesser 4 km/h
;    RESULTCOMMENT:Bereich: 0, wenn FALSE / 1, wenn TRUE
;    RESULT:I_EWS
;    RESULTTYPE:int
;    RESULTCOMMENT:Elektronische Wegfahrsperre
;    RESULTCOMMENT:Bereich: 0, wenn FALSE / 1, wenn TRUE
;    RESULT:I_FB_2MIN
;    RESULTTYPE:int
;    RESULTCOMMENT:2 Minuten nach Fernbedienung entriegeln
;    RESULTCOMMENT:Bereich: 0, wenn FALSE / 1, wenn TRUE
;
